# =====================================================================
# CYNERA SAAS BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Cyber Network Evaluation and Risk Analytics
# Location: D:\NEXORA\backend\.env.example
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION & FRONTEND URL CONFIGURATION
# ---------------------------------------------------------------------
APP_NAME=CYNERA
APP_ENV=development
DEBUG=true

# Enable the two CYNERA demo logins and synthetic demo workspace fixtures.
DEMO_MODE=true

# Central SaaS Backend API Endpoint
BACKEND_URL=http://127.0.0.1:8000

# Client Web Application Frontend URL
# Used for CORS validation, redirect links, email OTP links & callbacks
FRONTEND_URL=http://localhost:3000
# Production Frontend URL Example (Vercel / Cloud):
# FRONTEND_URL=https://cynera.vercel.app

# ---------------------------------------------------------------------
# 2. DATABASE CONFIGURATION & DETAILS
# ---------------------------------------------------------------------
# Active Primary Database Connection String
# Default: Local persistent SQLite (openable with DB Browser for SQLite)
DATABASE_URL=sqlite:///./backend/cynera.db

# Explicit Database Connection Attributes (PostgreSQL / Supabase / Cloud SQL)
DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cynera.db
DB_USER=
DB_PASSWORD=

# Supabase PostgreSQL Integration (For Cloud Production Deployment)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# 3. SMTP EMAIL & OTP VERIFICATION (PRIMARY AUTHENTICATION)
# ---------------------------------------------------------------------
# SMTP Server Configuration for dispatching 6-digit signup OTPs, 2FA, and password reset codes
# Works with Gmail (smtp.gmail.com), Outlook (smtp.office365.com), AWS SES, SendGrid, Brevo, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="CYNERA Security"
SMTP_REPLY_TO=support@cynera.io
SMTP_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------
# 4. 6-DIGIT OTP SECURITY & EXPIRATION SETTINGS
# ---------------------------------------------------------------------
OTP_HASH_SECRET=cynera-otp-hmac-salt-production-secure-key-2026-v1-789a
OTP_EXPIRE_MINUTES=10

# ---------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY TOKENS
# ---------------------------------------------------------------------
JWT_SECRET_KEY=cynera-2026-super-secret-jwt-key-98127398127
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Secret token for authenticating Tier 1 perimeter local collectors
COLLECTOR_AUTH_SECRET=secret-collector-token-01

# ---------------------------------------------------------------------
# 5. TIER 1 LOCAL COLLECTOR REFERENCE CONFIGURATION
# ---------------------------------------------------------------------
COLLECTOR_ID=col-prod-core-01
COLLECTOR_NAME="Primary Cluster Collector 01"
TENANT_ID=11111111-1111-1111-1111-111111111111
COLLECTOR_CREDENTIAL=secret-collector-token-01
COLLECTION_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=15
LOCAL_QUEUE_PATH=data/local_buffer.db
MAX_RETRY_ATTEMPTS=5
BACKOFF_FACTOR=1.5
VERSION=1.4.2
SIMULATED_MODE=false

# ---------------------------------------------------------------------
# 6. CORS ORIGINS & OBSERVABILITY
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
LOG_LEVEL=INFO

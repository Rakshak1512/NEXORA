# =====================================================================
# CYNERA SAAS BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Cyber Network Evaluation and Risk Analytics
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION & FRONTEND URL CONFIGURATION
# ---------------------------------------------------------------------
APP_NAME=CYNERA
APP_ENV=development
DEBUG=true

# Central SaaS Backend API Endpoint
BACKEND_URL=http://127.0.0.1:8000

# Client Web Application Frontend URL
# Used for CORS validation, redirect links, email OTP links & callbacks
FRONTEND_URL=http://localhost:3000
# Production Frontend URL Example (Vercel / Cloud):
# FRONTEND_URL=https://cynera.vercel.app

# ---------------------------------------------------------------------
# 2. DATABASE CONFIGURATION & DETAILS
# ---------------------------------------------------------------------
# Active Primary Database Connection String
# Default: Local persistent SQLite (openable with DB Browser for SQLite)
DATABASE_URL=sqlite:///./backend/cynera.db

# Explicit Database Connection Attributes (PostgreSQL / Supabase / Cloud SQL)
DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cynera.db
DB_USER=
DB_PASSWORD=

# Supabase PostgreSQL Integration (For Cloud Production Deployment)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# 3. RESEND EMAIL & OTP VERIFICATION DETAILS
# ---------------------------------------------------------------------
# Resend API Key for dispatching 6-digit signup OTPs and login 2FA verification
# Get your API key at: https://resend.com/api-keys (starts with re_)
# DEVELOPMENT MODE: If left empty or using default, CYNERA automatically
# prints the 6-digit verification code to the backend terminal: [DEV OTP: 123456]
RESEND_API_KEY=

# Sender Email Address & Brand Persona
# Use onboarding@resend.dev during testing or your verified domain e.g. alerts@cynera.io
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME="CYNERA Security"
RESEND_REPLY_TO=support@cynera.io

# 6-Digit OTP Security & Expiration Settings
OTP_HASH_SECRET=cynera-otp-salt-98723498237
OTP_EXPIRE_MINUTES=10

# ---------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY TOKENS
# ---------------------------------------------------------------------
JWT_SECRET_KEY=cynera-2026-super-secret-jwt-key-98127398127
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Secret token for authenticating Tier 1 perimeter local collectors
COLLECTOR_AUTH_SECRET=secret-collector-token-01

# ---------------------------------------------------------------------
# 5. CORS ORIGINS & OBSERVABILITY
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
LOG_LEVEL=INFO
